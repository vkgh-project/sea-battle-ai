GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
# gemini: Google Gemini API; demo: local bot without an API key.
AI_MODE=gemini
MAX_SESSIONS=1000
MAX_AI_CONCURRENCY=1
SESSION_TTL_MINUTES=60
# In production use the exact public URL, without a trailing slash.
# APP_ORIGIN=https://your-service.onrender.com
